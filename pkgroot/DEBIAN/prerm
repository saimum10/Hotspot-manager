#!/bin/bash
set -e

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if [ -f /usr/lib/hotspot-manager/backend.py ]; then
        python3 -c "
import sys
sys.path.insert(0, '/usr/lib/hotspot-manager')
try:
    import backend
    backend.delete_all_setup()
except Exception as e:
    print(f'[hotspot-manager] cleanup warning: {e}')
" || true
    fi
fi

exit 0
