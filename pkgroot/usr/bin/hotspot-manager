#!/bin/bash
# Hotspot Manager launcher — Saimum | Debian
# Elevates to root (whole app runs as root, like gparted/synaptic) so it can
# manage hostapd/dnsmasq/iptables directly. No terminal, no browser, no localhost.
#
# Anything the elevated process prints to stderr (Qt platform errors, Python
# tracebacks, pkexec/sudo failures) is also captured in $LOG, because a
# desktop-launched app has no visible terminal to show it in otherwise.

set -u
APPDIR="/usr/lib/hotspot-manager"
SETTINGS="/etc/hotspot-manager/settings.json"
LOG="/tmp/hotspot-manager-launch.log"

: > "$LOG" 2>/dev/null || true

get_flag() {
    python3 - "$SETTINGS" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
    print("1" if d.get("password_off") else "0")
except Exception:
    print("0")
PY
}

# Only force the xcb (X11 / XWayland) platform plugin when a display is
# actually available. If it's not, leave QT_QPA_PLATFORM unset so Qt can
# fall back to auto-detection (e.g. native wayland) instead of just failing.
if [ -n "${DISPLAY:-}" ]; then
    export QT_QPA_PLATFORM=xcb
fi

if [ "$(id -u)" = "0" ]; then
    exec /usr/bin/python3 "$APPDIR/main.py" "$@"
fi

FLAG="0"
if [ -f "$SETTINGS" ]; then
    FLAG="$(get_flag)"
fi

run_sudo() {
    sudo -n --preserve-env=DISPLAY,XAUTHORITY,QT_QPA_PLATFORM,WAYLAND_DISPLAY,XDG_RUNTIME_DIR,HOME \
        /usr/bin/python3 "$APPDIR/main.py" "$@" 2>>"$LOG"
}

run_pkexec() {
    pkexec env \
        DISPLAY="${DISPLAY:-}" \
        XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}" \
        WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-}" \
        XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-}" \
        QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-}" \
        HOME="$HOME" \
        /usr/bin/python3 "$APPDIR/main.py" "$@" 2>>"$LOG"
}

if [ "$FLAG" = "1" ]; then
    if run_sudo; then
        exit 0
    fi
    echo "[hotspot-manager] sudo -n failed, falling back to pkexec" >> "$LOG"
fi

run_pkexec
STATUS=$?
if [ "$STATUS" -ne 0 ]; then
    echo "[hotspot-manager] exited with status $STATUS — see $LOG for details" >&2
fi
exit "$STATUS"
